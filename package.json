{
  "name": "codex-netwatch",
  "version": "0.2.1",
  "private": true,
  "description": "Local-first Codex network observability through Mihomo, with honest session correlation.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.mjs",
    "demo": "node --disable-warning=ExperimentalWarning src/main.mjs --demo",
    "doctor": "node --disable-warning=ExperimentalWarning scripts/doctor.mjs",
    "test": "node scripts/test.mjs",
    "check": "node scripts/check.mjs",
    "stability": "node --disable-warning=ExperimentalWarning scripts/stability.mjs",
    "package:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "test:portable": "node desktop/smoke.mjs"
  },
